{
    "manufacturer": "Conrado Almeida",
    "keyboard_name": "Conrado Keyboard CK12",
    "url": "https://github.com/conradoalmeida",
    "maintainer": "conradoalmeida",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0000",
        "device_version": "1.0.0"
    },
    "matrix_pins": {
        "cols": ["GP2", "GP3", "GP4", "GP5"],
        "rows": ["GP6", "GP7", "GP8"]
    },
    "diode_direction": "COL2ROW",
    "matrix": {
        "ghost": true
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": false,
        "nkro": false
    },
    "bootmagic": {
        "matrix": [0, 0]
    },
    "dynamic_keymap": {
        "layer_count": 8
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },
                { "matrix": [0, 3], "x": 3, "y": 0 },

                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 },
                { "matrix": [1, 2], "x": 2, "y": 1 },
                { "matrix": [1, 3], "x": 3, "y": 1 },

                { "matrix": [2, 0], "x": 0, "y": 2 },
                { "matrix": [2, 1], "x": 1, "y": 2 },
                { "matrix": [2, 2], "x": 2, "y": 2 },
                { "matrix": [2, 3], "x": 3, "y": 2 }
            ]
        }
    }
}
